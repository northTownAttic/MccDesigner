<Window x:Class="MccDesigner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MccDesigner" xmlns:converters="clr-namespace:MccDesigner.Converters" PreviewMouseDown="Window_PreviewMouseDown" Title="MCC Designer MVP" Height="1080" Width="1920" WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize" Background="#F1F5F9">
<Window.Resources><converters:OperationEndTimeConverter x:Key="OperationEndTime"/><Style x:Key="PreviousWaitDisplay" TargetType="CheckBox" BasedOn="{x:Static DataGridCheckBoxColumn.DefaultElementStyle}">
<Style.Triggers><DataTrigger Binding="{Binding HasExplicitPredecessor}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
</Style>
<Style x:Key="PreviousWaitEditing" TargetType="CheckBox" BasedOn="{x:Static DataGridCheckBoxColumn.DefaultEditingElementStyle}">
<Style.Triggers><DataTrigger Binding="{Binding HasExplicitPredecessor}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
</Style>
</Window.Resources>
<Viewbox Stretch="Uniform"><Grid Width="1920" Height="1080"><DockPanel>
<Border DockPanel.Dock="Top" Background="#0F172A" Padding="16"><DockPanel>
<StackPanel><TextBlock Text="MCC Designer" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Machine Cycle Chart · MVP" Foreground="#CBD5E1"/></StackPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
<Button Content="최소화" Click="Minimize_Click"/><Button Content="종료" Click="Close_Click"/>
<Button Content="작업 추가" Command="{Binding AddCommand}"/><Button Content="선택 삭제" Command="{Binding RemoveCommand}"/><Button Content="MCC 계산" Command="{Binding CalculateCommand}" Background="#2563EB" Foreground="White"/><Button Content="불러오기" Command="{Binding LoadCommand}"/><Button Content="저장" Command="{Binding SaveCommand}"/>
</StackPanel></DockPanel></Border>
<Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height="1*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,6,6"><DockPanel>
<StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
<TextBlock Text="작업 편집 · Stage=X / Head=Y" FontSize="16" FontWeight="SemiBold"/>
<TextBlock Text="{Binding AxisHint}" TextWrapping="Wrap" Foreground="#64748B"/>
<TextBlock Text="선행 작업을 직접 선택하면 ‘이전 완료 대기’ 대신 해당 작업의 완료를 기다립니다." TextWrapping="Wrap" Foreground="#475569"/>
<StackPanel Orientation="Horizontal"><Button Content="위로 ↑" Command="{Binding MoveUpCommand}"/><Button Content="아래로 ↓" Command="{Binding MoveDownCommand}"/><TextBlock Text="목록 순서 = 자원 배정 우선순위" VerticalAlignment="Center" Foreground="#64748B"/></StackPanel>
</StackPanel>
<DataGrid x:Name="OperationsGrid" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" CellEditEnding="OperationsGrid_CellEditEnding" CommandManager.PreviewExecuted="OperationsGrid_PreviewExecuted">
<DataGrid.Columns>
<DataGridTextColumn Header="작업" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
<DataGridComboBoxColumn Header="장비" SelectedItemBinding="{Binding Resource, UpdateSourceTrigger=PropertyChanged}" Width="110" ItemsSource="{x:Static local:EditorOptions.Resources}"/>
<DataGridTextColumn Header="시간(s)" Binding="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.###}" Width="75"/>
<DataGridTemplateColumn Header="누적 시간(s)" IsReadOnly="True" CanUserSort="False" Width="100">
<DataGridTemplateColumn.CellTemplate><DataTemplate>
<TextBlock TextAlignment="Right" Padding="4,0" VerticalAlignment="Center" ToolTip="사이클 시작부터 이 작업이 완료될 때까지의 시간입니다. 병렬 작업과 자원 대기를 반영하며 타임차트의 작업 종료 시각과 같습니다. 계산 오류 시 — 로 표시합니다.">
<TextBlock.Text><MultiBinding Converter="{StaticResource OperationEndTime}" Mode="OneWay">
<Binding Path="Id"/><Binding Path="DataContext.OperationEndTimes" RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}"/>
</MultiBinding></TextBlock.Text>
</TextBlock>
</DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="선행 작업" Width="190">
<DataGridTemplateColumn.CellTemplate><DataTemplate>
<ComboBox ItemsSource="{Binding DataContext.PredecessorChoices, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" SelectedValue="{Binding PredecessorId, Mode=OneWay}" SelectedValuePath="Id" DisplayMemberPath="Label" IsHitTestVisible="False" Focusable="False" BorderThickness="0" Background="Transparent"/>
</DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
<ComboBox ItemsSource="{Binding DataContext.PredecessorChoices, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" SelectedValue="{Binding PredecessorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="Label" MaxDropDownHeight="300" ToolTip="기본: 이전 완료 대기 설정 사용. 작업 선택: 해당 작업이 끝난 후 자원이 가능할 때 실행."/>
</DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
<DataGridCheckBoxColumn Header="이전 완료 대기" ElementStyle="{StaticResource PreviousWaitDisplay}" EditingElementStyle="{StaticResource PreviousWaitEditing}" Binding="{Binding WaitForPrevious, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
<DataGridCheckBoxColumn Header="미디어 로딩" Binding="{Binding IsLoading, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
<DataGridCheckBoxColumn Header="헤드 사용" Binding="{Binding RequiresScannerHead, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
<DataGridCheckBoxColumn Header="이동" Binding="{Binding IsMotion, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
<DataGridTextColumn Header="시작(mm)" Binding="{Binding StartPosition, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.###}" Width="65"/>
<DataGridTextColumn Header="끝(mm)" Binding="{Binding EndPosition, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.###}" Width="65"/>
</DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="10" Margin="6,0,0,6"><DockPanel>
<StackPanel DockPanel.Dock="Top">
<DockPanel><Button DockPanel.Dock="Right" Content="설비 설정 (mm)" Command="{Binding EditMachineCommand}"/><TextBlock Text="설비 시뮬레이터" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<WrapPanel Margin="0,6,0,8"><Button Content="재생 ▶" Click="Play_Click"/><Button Content="일시정지 Ⅱ" Click="Pause_Click"/><Button Content="중지 ■" Click="Stop_Click"/><Button Content="처음으로" Click="Reset_Click"/><TextBlock Text="{Binding CurrentTimeLabel}" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"/></WrapPanel>
<WrapPanel IsEnabled="{Binding CanEditPlayback}" Margin="0,0,0,4">
<TextBlock Text="반복 횟수" VerticalAlignment="Center"/>
<TextBox x:Name="RepeatCountInput" Width="65" Text="{Binding RepeatCount, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" ToolTip="1회는 단일 실행, 2회 이상은 복귀 위치를 검사합니다."/>
<CheckBox Content="무한 반복" IsChecked="{Binding InfiniteRepeat}" VerticalAlignment="Center" Margin="8,0"/>
</WrapPanel>
<WrapPanel IsEnabled="{Binding CanEditPlayback}" Margin="0,0,0,4">
<CheckBox Content="전처리 연동" IsChecked="{Binding SupplyEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
<TextBlock Text="주기(s)" VerticalAlignment="Center"/>
<TextBox x:Name="SupplyIntervalInput" Width="65" Text="{Binding SupplyInterval, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
<TextBlock Text="매/회" VerticalAlignment="Center"/>
<TextBox x:Name="SupplyBatchInput" Width="45" Text="{Binding SupplyBatchSize, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
<CheckBox Content="시작 즉시 첫 공급" IsChecked="{Binding SupplyAtStart}" VerticalAlignment="Center" Margin="8,0"/>
</WrapPanel>
<Border Padding="8" Margin="0,0,0,5" CornerRadius="4">
<Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E0E7FF"/><Style.Triggers><DataTrigger Binding="{Binding HasWaitingMedia}" Value="True"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger></Style.Triggers></Style></Border.Style>
<TextBlock Text="{Binding SupplyStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#312E81"/>
</Border>
<TextBlock Text="{Binding PlaybackProgress}" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,5"/>
<DockPanel Margin="0,0,0,5">
<Button DockPanel.Dock="Right" Content="화면 맞춤" Click="FitMachine_Click"/>
<TextBlock DockPanel.Dock="Left" Text="확대" VerticalAlignment="Center" Margin="0,0,6,0"/>
<TextBlock DockPanel.Dock="Right" Text="{Binding SimulatorZoom, StringFormat={}{0:0}%}" Width="45" VerticalAlignment="Center" Margin="6,0"/>
<Slider Minimum="100" Maximum="400" TickFrequency="25" IsSnapToTickEnabled="True" Value="{Binding SimulatorZoom, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="100% 화면 맞춤 ~ 400% 확대; 스크롤바로 설비 위치를 이동합니다."/>
</DockPanel>
</StackPanel>
<ScrollViewer x:Name="MachineScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Background="#F8FAFC"><Canvas x:Name="MachineCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True" Background="#F8FAFC"/></ScrollViewer></DockPanel></Border>
<Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" CornerRadius="8" Padding="10" Margin="0,6"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="MCC 타임차트" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="클릭·드래그: 시간 탐색 (일시정지) · 연한 막대: 스캔 중 헤드 점유" TextWrapping="Wrap" Foreground="#64748B" Margin="0,3,0,6"/></StackPanel>
<ScrollViewer x:Name="TimelineScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="TimelineCanvas" Cursor="ScrollWE" MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp" LostMouseCapture="Timeline_LostCapture" Height="210" Width="900" Background="#F8FAFC"/></ScrollViewer></DockPanel></Border>
<Border Grid.Row="2" Grid.ColumnSpan="2" Background="#E2E8F0" CornerRadius="6" Padding="10"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#334155"/></Border>
</Grid></DockPanel></Grid></Viewbox></Window>
