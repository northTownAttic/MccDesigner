<Window x:Class="MccDesigner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MccDesigner" PreviewMouseDown="Window_PreviewMouseDown" Title="MCC Designer MVP" Height="800" Width="1350" MinHeight="650" MinWidth="1000" Background="#F1F5F9">
<DockPanel>
<Border DockPanel.Dock="Top" Background="#0F172A" Padding="16"><DockPanel>
<StackPanel><TextBlock Text="MCC Designer" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Machine Cycle Chart · MVP" Foreground="#CBD5E1"/></StackPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
<Button Content="작업 추가" Command="{Binding AddCommand}"/><Button Content="선택 삭제" Command="{Binding RemoveCommand}"/><Button Content="MCC 계산" Command="{Binding CalculateCommand}" Background="#2563EB" Foreground="White"/><Button Content="불러오기" Command="{Binding LoadCommand}"/><Button Content="저장" Command="{Binding SaveCommand}"/>
</StackPanel></DockPanel></Border>
<Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height="1*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,6,6"><DockPanel>
<StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
<TextBlock Text="작업 편집" FontSize="16" FontWeight="SemiBold"/>
<TextBlock Text="이전 완료 대기: 해제하면 자원이 비는 시점에 병렬 실행합니다." TextWrapping="Wrap" Foreground="#64748B"/>
<StackPanel Orientation="Horizontal"><Button Content="위로 ↑" Command="{Binding MoveUpCommand}"/><Button Content="아래로 ↓" Command="{Binding MoveDownCommand}"/><TextBlock Text="목록 순서 = 자원 배정 우선순위" VerticalAlignment="Center" Foreground="#64748B"/></StackPanel>
</StackPanel>
<DataGrid x:Name="OperationsGrid" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" CellEditEnding="OperationsGrid_CellEditEnding" CommandManager.PreviewExecuted="OperationsGrid_PreviewExecuted">
<DataGrid.Columns>
<DataGridTextColumn Header="작업" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
<DataGridComboBoxColumn Header="장비" SelectedItemBinding="{Binding Resource, UpdateSourceTrigger=PropertyChanged}" Width="110" ItemsSource="{x:Static local:EditorOptions.Resources}"/>
<DataGridTextColumn Header="시간(s)" Binding="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.###}" Width="75"/>
<DataGridCheckBoxColumn Header="이전 완료 대기" Binding="{Binding WaitForPrevious, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
<DataGridCheckBoxColumn Header="열 점유" Binding="{Binding OccupiesTargetLane, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
<DataGridCheckBoxColumn Header="이동" Binding="{Binding IsMotion, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
<DataGridTextColumn Header="X 시작" Binding="{Binding StartPosition, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.###}" Width="65"/>
<DataGridTextColumn Header="X 끝" Binding="{Binding EndPosition, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.###}" Width="65"/>
<DataGridComboBoxColumn Header="대상 열" SelectedItemBinding="{Binding TargetLane, UpdateSourceTrigger=PropertyChanged}" Width="90" ItemsSource="{x:Static local:EditorOptions.Lanes}"/>
</DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="10" Margin="6,0,0,6"><DockPanel>
<StackPanel DockPanel.Dock="Top">
<TextBlock Text="설비 시뮬레이터" FontSize="16" FontWeight="SemiBold"/>
<WrapPanel Margin="0,6,0,8"><Button Content="재생 ▶" Click="Play_Click"/><Button Content="일시정지 Ⅱ" Click="Pause_Click"/><Button Content="처음으로" Click="Reset_Click"/><TextBlock Text="{Binding CurrentTimeLabel}" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"/></WrapPanel>
</StackPanel>
<Canvas x:Name="MachineCanvas" Height="150" Background="#F8FAFC"/></DockPanel></Border>
<Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" CornerRadius="8" Padding="10" Margin="0,6"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="MCC 타임차트" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="이전 작업 완료 조건과 공유 자원을 반영한 일정 · 연한 막대는 헤드 작업의 스테이지 점유" TextWrapping="Wrap" Foreground="#64748B" Margin="0,3,0,6"/></StackPanel>
<ScrollViewer x:Name="TimelineScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="TimelineCanvas" Height="210" Width="900" Background="#F8FAFC"/></ScrollViewer></DockPanel></Border>
<Border Grid.Row="2" Grid.ColumnSpan="2" Background="#E2E8F0" CornerRadius="6" Padding="10"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#334155"/></Border>
</Grid></DockPanel></Window>
